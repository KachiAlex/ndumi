PORT=3001

# LLM — Google Gemini (via Vercel proxy if VPS location is blocked)
GEMINI_API_KEY=
GEMINI_PROXY_URL=

# TTS Provider 1 — Orinode (Nigerian-native, free beta)
# Get key at https://maraba.ai/products/orinode-tts/
ORINODE_API_KEY=

# TTS Provider 2 — Fish Audio (free through Aug 2026, no cap, 83 languages)
# Get key at https://fish.audio/app/api-keys
FISH_AUDIO_API_KEY=

# TTS Provider 3 — Google Cloud TTS (4M+1M chars/month permanent free)
# Create a service account and download JSON, paste the full JSON here
# https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_TTS_SERVICE_ACCOUNT_JSON=

# TTS Provider 4 — 9ja Lingo (existing, rate-limited on Starter plan)
NJA_LINGO_API_KEY=

# TTS Provider 5 — Spitch (existing, credits may be exhausted)
SPITCH_API_KEY=

# ASR Provider 1 — Groq Whisper (free, 2000 req/day, no card needed)
# Get key at https://console.groq.com
GROQ_API_KEY=

# ASR Provider 2 — Spitch (fallback, credits may be exhausted)
SPITCH_API_KEY=

# ASR Service (Python/FastAPI on VPS, fallback)
ASR_SERVICE_URL=http://localhost:3010

# TTS Service (fallback)
TTS_SERVICE_URL=http://localhost:3002

# Redis (for session storage in production)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=

# CORS
CORS_ORIGIN=http://localhost:5173

PORT=3001

# LLM — Google Gemini (via Vercel proxy if VPS location is blocked)
GEMINI_API_KEY=
GEMINI_PROXY_URL=

# ASR — Spitch (speech-to-text for Nigerian languages)
SPITCH_API_KEY=

# TTS — 9ja Lingo (text-to-speech for Nigerian languages)
NJA_LINGO_API_KEY=

# ASR Service (Python/FastAPI on VPS, fallback)
ASR_SERVICE_URL=http://localhost:3010

# TTS Service (fallback)
TTS_SERVICE_URL=http://localhost:3002

# Redis (for session storage in production)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=

# CORS
CORS_ORIGIN=http://localhost:5173
